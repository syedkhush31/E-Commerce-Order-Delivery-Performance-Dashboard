{
  "name": "Fulfillment Analytics",
  "dataColors": ["#2A6FDB", "#D9534F", "#F0AD4E", "#5CB85C", "#5BC0DE", "#8E6FD8", "#7F8C8D", "#E67E22"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2A6FDB",
  "good": "#5CB85C",
  "neutral": "#F0AD4E",
  "bad": "#D9534F",
  "maximum": "#2A6FDB",
  "center": "#F0AD4E",
  "minimum": "#D9534F",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2937" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4B5563" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F2937" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 6 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }]
      }
    }
  }
}
